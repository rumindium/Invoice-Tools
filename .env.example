# Copy to .env for local development. Never commit .env.
NODE_ENV=development
APP_ENV=local
APP_VERSION=0.1.0
LOG_LEVEL=debug

# Web (Angular SSR)
WEB_PORT=4210
# Public web origin; activation and password reset links point here.
PUBLIC_ORIGIN=http://localhost:4210

# API
API_PORT=4310
CORS_ORIGINS=http://localhost:4210

# PostgreSQL 16 (local install or any reachable server)
DATABASE_URL=postgresql://invoice:invoice@localhost:5432/invoice_dev?schema=public

# Outgoing mail.
# Development: `npm run dev` starts Mailpit on 1025 and its inbox at http://localhost:8025.
# Production: point these at your SMTP provider and set the credentials.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Rumindium Invoice <no-reply@rumindium.local>"
