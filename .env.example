# Copy to .env for local development. Never commit .env.
NODE_ENV=development
APP_ENV=local
APP_VERSION=0.1.0
LOG_LEVEL=debug

# Web (Angular SSR)
WEB_PORT=4210
PUBLIC_ORIGIN=http://localhost:4210

# API
API_PORT=4310
CORS_ORIGINS=http://localhost:4210

# PostgreSQL 16 (local install or any reachable server)
DATABASE_URL=postgresql://invoice:invoice@localhost:5432/invoice_dev?schema=public
