// Rumindium Invoice — schema v1 (P0 foundation).
// Money and quantities are Decimal/NUMERIC, never floating point.
// See docs/0-DATABASE.md and docs/0-DOCUMENT-MODEL.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum DocumentType {
  QUOTATION
  SALES_ORDER
  DELIVERY_ORDER
  INVOICE
  RECEIPT
  CREDIT_NOTE
  DEBIT_NOTE
}

enum DocumentStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
  PARTIALLY_DELIVERED
  DELIVERED
}

enum TaxMode {
  EXCLUSIVE
  INCLUSIVE
}

enum DiscountType {
  NONE
  PERCENT
  AMOUNT
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS
}

enum CatalogKind {
  PRODUCT
  SERVICE
}

enum QuotationLabel {
  QUOTATION
  SPH
  BOTH
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  OTHER
}

enum PaymentStatus {
  RECORDED
  VOIDED
}

enum RelationType {
  CONVERTED_TO
  REVISED_FROM
  RECEIPT_FOR
  CREDIT_OF
  DEBIT_OF
}

enum SequenceReset {
  NEVER
  YEARLY
  MONTHLY
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model User {
  id          String    @id @db.Text
  subject     String    @unique
  email        String    @unique @db.Citext
  displayName  String    @map("display_name")
  passwordHash String?   @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt  DateTime? @map("last_seen_at") @db.Timestamptz(6)

  sessions          Session[]
  ownedWorkspaces   Workspace[]        @relation("WorkspaceOwner")
  memberships       WorkspaceMember[]
  createdDocuments  Document[]         @relation("DocumentCreator")
  createdRelations  DocumentRelation[] @relation("RelationCreator")
  createdRevisions  DocumentRevision[] @relation("RevisionCreator")
  recordedPayments  Payment[]          @relation("PaymentRecorder")
  voidedPayments    Payment[]          @relation("PaymentVoider")
  printTokens       PrintToken[]
  auditEvents       AuditEvent[]
  idempotencyKeys   IdempotencyKey[]

  @@map("users")
}

model Session {
  id            String   @id @db.Text
  userId        String   @map("user_id") @db.Text
  tokenHash     Bytes    @unique @map("token_hash")
  csrfTokenHash Bytes    @map("csrf_token_hash")
  ip            String?  @db.Inet
  userAgent     String?  @map("user_agent")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt    DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt     DateTime @map("expires_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Workspace {
  id           String   @id @db.Text
  name         String
  ownerId      String   @map("owner_id") @db.Text
  authTenantId String?  @unique @map("auth_tenant_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner       User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members     WorkspaceMember[]
  companies   Company[]
  customers   Customer[]
  catalog     CatalogItem[]
  documents   Document[]
  payments    Payment[]
  assets      Asset[]
  auditEvents AuditEvent[]

  @@index([ownerId])
  @@map("workspaces")
}

model WorkspaceMember {
  workspaceId String        @map("workspace_id") @db.Text
  userId      String        @map("user_id") @db.Text
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@map("workspace_members")
}

model Company {
  id                     String         @id @db.Text
  workspaceId            String         @map("workspace_id") @db.Text
  legalName              String         @map("legal_name")
  displayName            String?        @map("display_name")
  logoAssetId            String?        @map("logo_asset_id") @db.Text
  addressLine1           String?        @map("address_line1")
  addressLine2           String?        @map("address_line2")
  city                   String?
  province               String?
  postalCode             String?        @map("postal_code")
  countryCode            String         @default("ID") @map("country_code") @db.Char(2)
  email                  String?
  phone                  String?
  website                String?
  taxId                  String?        @map("tax_id")
  taxLabel               String         @default("Tax ID") @map("tax_label")
  bankDetails            Json           @default("[]") @map("bank_details")
  defaultCurrency        String         @default("IDR") @map("default_currency") @db.Char(3)
  defaultLocale          String         @default("id-ID") @map("default_locale")
  timeZone               String         @default("Asia/Jakarta") @map("time_zone")
  quotationLabel         QuotationLabel @default(BOTH) @map("quotation_label")
  defaultTaxRate         Decimal        @default(0) @map("default_tax_rate") @db.Decimal(7, 4)
  defaultTaxMode         TaxMode        @default(EXCLUSIVE) @map("default_tax_mode")
  defaultPaymentTermDays Int            @default(14) @map("default_payment_term_days") @db.SmallInt
  footerText             String?        @map("footer_text") @db.Text
  signatoryName          String?        @map("signatory_name")
  signatoryTitle         String?        @map("signatory_title")
  isDefault              Boolean        @default(false) @map("is_default")
  archivedAt             DateTime?      @map("archived_at") @db.Timestamptz(6)
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  logoAsset   Asset?             @relation("CompanyLogo", fields: [logoAssetId], references: [id], onDelete: SetNull)
  sequences   DocumentNumberSequence[]
  templates   DocumentTemplate[]
  documents   Document[]

  @@index([workspaceId, archivedAt])
  @@index([workspaceId, isDefault])
  @@map("companies")
}

model Customer {
  id                     String        @id @db.Text
  workspaceId            String        @map("workspace_id") @db.Text
  type                   CustomerType  @default(INDIVIDUAL)
  name                   String
  contactPerson          String?       @map("contact_person")
  email                  String?
  phone                  String?
  billingAddress         Json?         @map("billing_address")
  shippingAddress        Json?         @map("shipping_address")
  taxId                  String?       @map("tax_id")
  notes                  String?       @db.Text
  defaultPaymentTermDays Int?          @map("default_payment_term_days") @db.SmallInt
  archivedAt             DateTime?     @map("archived_at") @db.Timestamptz(6)
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  documents Document[]

  @@index([workspaceId, name])
  @@index([workspaceId, archivedAt])
  @@map("customers")
}

model CatalogItem {
  id          String      @id @db.Text
  workspaceId String      @map("workspace_id") @db.Text
  kind        CatalogKind @default(SERVICE)
  name        String
  sku         String?
  description String?     @db.Text
  unit        String      @default("unit")
  unitPrice   Decimal     @map("unit_price") @db.Decimal(19, 4)
  taxRate     Decimal?    @map("tax_rate") @db.Decimal(7, 4)
  isActive    Boolean     @default(true) @map("is_active")
  archivedAt  DateTime?   @map("archived_at") @db.Timestamptz(6)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  documentItems DocumentItem[]

  @@unique([workspaceId, sku])
  @@index([workspaceId, name])
  @@index([workspaceId, archivedAt])
  @@map("catalog_items")
}

model DocumentNumberSequence {
  id           String        @id @db.Text
  companyId    String        @map("company_id") @db.Text
  documentType DocumentType  @map("document_type")
  pattern      String
  resetPolicy  SequenceReset @default(YEARLY) @map("reset_policy")
  padding      Int           @default(4) @db.SmallInt
  periodKey    String        @map("period_key")
  nextValue    Int           @default(1) @map("next_value")
  lastIssuedAt DateTime?     @map("last_issued_at") @db.Timestamptz(6)
  version      Int           @default(1)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, documentType])
  @@map("document_number_sequences")
}

model DocumentTemplate {
  id                   String    @id @db.Text
  companyId            String?   @map("company_id") @db.Text
  name                 String
  slug                 String
  layout               String    @default("classic")
  paperSize            String    @default("A4") @map("paper_size")
  orientation          String    @default("portrait")
  accentColor          String    @default("#1F5F5B") @map("accent_color")
  logoPosition         String    @default("left") @map("logo_position")
  showBankDetails      Boolean   @default(true) @map("show_bank_details")
  showSignature        Boolean   @default(true) @map("show_signature")
  showPricesOnDelivery Boolean   @default(false) @map("show_prices_on_delivery")
  footerText           String?   @map("footer_text") @db.Text
  isDefault            Boolean   @default(false) @map("is_default")
  archivedAt           DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  company   Company?   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  documents Document[]

  @@unique([companyId, slug])
  @@index([companyId, isDefault])
  @@map("document_templates")
}

model Document {
  id                  String         @id @db.Text
  workspaceId         String         @map("workspace_id") @db.Text
  companyId           String         @map("company_id") @db.Text
  customerId          String?        @map("customer_id") @db.Text
  templateId          String?        @map("template_id") @db.Text
  documentType        DocumentType   @map("document_type")
  status              DocumentStatus @default(DRAFT)
  documentNumber      String?        @map("document_number")
  sequencePeriod      String?        @map("sequence_period")
  issueDate           DateTime       @map("issue_date") @db.Date
  dueDate             DateTime?      @map("due_date") @db.Date
  validUntil          DateTime?      @map("valid_until") @db.Date
  referenceNumber     String?        @map("reference_number")
  currencyCode        String         @map("currency_code") @db.Char(3)
  taxMode             TaxMode        @default(EXCLUSIVE) @map("tax_mode")
  discountType        DiscountType   @default(NONE) @map("discount_type")
  discountRate        Decimal?       @map("discount_rate") @db.Decimal(7, 4)
  discountAmount      Decimal        @default(0) @map("discount_amount") @db.Decimal(19, 4)
  subtotal            Decimal        @default(0) @db.Decimal(19, 4)
  discountTotal       Decimal        @default(0) @map("discount_total") @db.Decimal(19, 4)
  taxTotal            Decimal        @default(0) @map("tax_total") @db.Decimal(19, 4)
  shippingAmount      Decimal        @default(0) @map("shipping_amount") @db.Decimal(19, 4)
  additionalCharges   Decimal        @default(0) @map("additional_charges") @db.Decimal(19, 4)
  chargesTaxRate      Decimal?       @map("charges_tax_rate") @db.Decimal(7, 4)
  chargesTax          Decimal        @default(0) @map("charges_tax") @db.Decimal(19, 4)
  grandTotal          Decimal        @default(0) @map("grand_total") @db.Decimal(19, 4)
  amountPaid          Decimal        @default(0) @map("amount_paid") @db.Decimal(19, 4)
  balanceDue          Decimal        @default(0) @map("balance_due") @db.Decimal(19, 4)
  notes               String?        @db.Text
  terms               String?        @db.Text
  issuerSnapshot      Json?          @map("issuer_snapshot")
  customerSnapshot    Json?          @map("customer_snapshot")
  templateSnapshot    Json?          @map("template_snapshot")
  calculationSnapshot Json?          @map("calculation_snapshot")
  pdfAssetId          String?        @map("pdf_asset_id") @db.Text
  version             Int            @default(1)
  issuedAt            DateTime?      @map("issued_at") @db.Timestamptz(6)
  voidedAt            DateTime?      @map("voided_at") @db.Timestamptz(6)
  voidReason          String?        @map("void_reason") @db.Text
  createdById         String         @map("created_by") @db.Text
  deletedAt           DateTime?      @map("deleted_at") @db.Timestamptz(6)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer          Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  template          DocumentTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdBy         User               @relation("DocumentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  pdfAsset          Asset?             @relation("DocumentPdf", fields: [pdfAssetId], references: [id], onDelete: SetNull)
  items             DocumentItem[]
  outgoingRelations DocumentRelation[] @relation("SourceDocument")
  incomingRelations DocumentRelation[] @relation("TargetDocument")
  revisions         DocumentRevision[]
  payments          Payment[]          @relation("InvoicePayments")
  receiptPayment    Payment?           @relation("ReceiptPayment")
  printTokens       PrintToken[]

  @@unique([companyId, documentType, documentNumber])
  @@index([workspaceId, updatedAt])
  @@index([companyId, status, dueDate])
  @@index([companyId, customerId, issueDate])
  @@index([companyId, createdAt])
  @@map("documents")
}

model DocumentItem {
  id             String       @id @db.Text
  documentId     String       @map("document_id") @db.Text
  position       Int
  catalogItemId  String?      @map("catalog_item_id") @db.Text
  itemName       String       @map("item_name")
  description    String?      @db.Text
  quantity       Decimal      @db.Decimal(18, 4)
  unit           String       @default("unit")
  unitPrice      Decimal      @map("unit_price") @db.Decimal(19, 4)
  discountType   DiscountType @default(NONE) @map("discount_type")
  discountRate   Decimal?     @map("discount_rate") @db.Decimal(7, 4)
  discountAmount Decimal      @default(0) @map("discount_amount") @db.Decimal(19, 4)
  taxRate        Decimal      @default(0) @map("tax_rate") @db.Decimal(7, 4)
  taxAmount      Decimal      @default(0) @map("tax_amount") @db.Decimal(19, 4)
  lineSubtotal   Decimal      @default(0) @map("line_subtotal") @db.Decimal(19, 4)
  lineTotal      Decimal      @default(0) @map("line_total") @db.Decimal(19, 4)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  document    Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  catalogItem CatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)

  @@unique([documentId, position])
  @@map("document_items")
}

model DocumentRelation {
  id               String       @id @db.Text
  sourceDocumentId String       @map("source_document_id") @db.Text
  targetDocumentId String       @map("target_document_id") @db.Text
  relationType     RelationType @map("relation_type")
  createdById      String?      @map("created_by") @db.Text
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  sourceDocument Document @relation("SourceDocument", fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  targetDocument Document @relation("TargetDocument", fields: [targetDocumentId], references: [id], onDelete: Cascade)
  createdBy      User?    @relation("RelationCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([targetDocumentId, relationType])
  @@index([sourceDocumentId])
  @@map("document_relations")
}

model DocumentRevision {
  id             String   @id @db.Text
  documentId     String   @map("document_id") @db.Text
  revisionNumber Int      @map("revision_number")
  snapshot       Json
  checksum       String
  reason         String?  @db.Text
  createdById    String?  @map("created_by") @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  document  Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("RevisionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([documentId, revisionNumber])
  @@map("document_revisions")
}

model Payment {
  id                String        @id @db.Text
  workspaceId       String        @map("workspace_id") @db.Text
  invoiceId         String        @map("invoice_id") @db.Text
  receiptDocumentId String        @unique @map("receipt_document_id") @db.Text
  paymentDate       DateTime      @map("payment_date") @db.Date
  amount            Decimal       @db.Decimal(19, 4)
  currencyCode      String        @map("currency_code") @db.Char(3)
  method            PaymentMethod @default(BANK_TRANSFER)
  reference         String?
  notes             String?       @db.Text
  status            PaymentStatus @default(RECORDED)
  recordedById      String        @map("recorded_by") @db.Text
  voidedAt          DateTime?     @map("voided_at") @db.Timestamptz(6)
  voidedById        String?       @map("voided_by") @db.Text
  voidReason        String?       @map("void_reason") @db.Text
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoice         Document  @relation("InvoicePayments", fields: [invoiceId], references: [id], onDelete: Restrict)
  receiptDocument Document  @relation("ReceiptPayment", fields: [receiptDocumentId], references: [id], onDelete: Restrict)
  recordedBy      User      @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  voidedBy        User?     @relation("PaymentVoider", fields: [voidedById], references: [id], onDelete: SetNull)

  @@index([invoiceId, paymentDate])
  @@index([workspaceId, status])
  @@map("payments")
}

model Asset {
  id          String   @id @db.Text
  workspaceId String   @map("workspace_id") @db.Text
  sha256      Bytes
  mime        String
  bytes       Int
  width       Int?
  height      Int?
  storageKey  String   @map("storage_key")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace     Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  companyLogos  Company[]  @relation("CompanyLogo")
  documentPdfs  Document[] @relation("DocumentPdf")

  @@unique([workspaceId, sha256])
  @@map("assets")
}

model PrintToken {
  id             String    @id @db.Text
  tokenHash      Bytes     @unique @map("token_hash")
  documentId     String    @map("document_id") @db.Text
  revisionNumber Int       @default(0) @map("revision_number")
  createdById    String?   @map("created_by") @db.Text
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  document  Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdBy User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([expiresAt])
  @@map("print_tokens")
}

model BackgroundJob {
  id          String    @id @db.Text
  kind        String
  payload     Json
  status      JobStatus @default(QUEUED)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3) @map("max_attempts")
  runAt       DateTime  @default(now()) @map("run_at") @db.Timestamptz(6)
  lockedAt    DateTime? @map("locked_at") @db.Timestamptz(6)
  lockedBy    String?   @map("locked_by")
  lastError   String?   @map("last_error") @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz(6)

  @@index([status, runAt])
  @@map("background_jobs")
}

model AuditEvent {
  id          BigInt   @id @default(autoincrement())
  workspaceId String?  @map("workspace_id") @db.Text
  actorId     String?  @map("actor_id") @db.Text
  action      String
  targetType  String   @map("target_type")
  targetId    String   @map("target_id")
  metadata    Json?
  ip          String?  @db.Inet
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?      @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@map("audit_events")
}

model IdempotencyKey {
  id           String   @id @db.Text
  userId       String   @map("user_id") @db.Text
  route        String
  key          String
  requestHash  Bytes    @map("request_hash")
  statusCode   Int      @map("status_code")
  responseBody Json     @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, route, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}
